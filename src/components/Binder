import React, { useState, useEffect, useCallback, useRef } from 'react';
import { Project, DocumentType } from '../types';
import {
  Folder,
  FolderOpen,
  Clapperboard,
  BookOpen,
  FileText,
  ChevronRight,
  ChevronDown,
  Plus,
  Trash2,
  Pencil,
  ArrowUp,
  ArrowDown,
  Check,
  X,
  MoreHorizontal,
  FolderPlus,
  RotateCcw,
  Sparkles,
} from 'lucide-react';

interface BinderProps {
  project: Project;
  allProjects?: Project[];
  activeDocId: string | null;
  onSelectDoc: (id: string) => void;
  onSelectProject?: (projectId: string) => void;
  onOpenHub?: () => void;
  onUpdateProjectTitle?: (newTitle: string) => void;
  onCreateNewProject?: (title: string) => void;
  onCreateFolder: (parentId: string | null, title: string) => void;
  onCreateDocument: (parentId: string | null, title: string, docType: DocumentType) => void;
  onDeleteItem: (id: string) => void;
  onRestoreItem?: (id: string) => void;
  onPermanentDeleteItem?: (id: string) => void;
  onEmptyTrash?: () => void;
  onMoveItem?: (draggedId: string, targetParentId: string | null) => void;
  onRenameItem: (id: string, newTitle: string) => void;
  onReorderItem: (id: string, direction: 'up' | 'down') => void;
}

export const Binder: React.FC<BinderProps> = ({
  project,
  allProjects,
  activeDocId,
  onSelectDoc,
  onSelectProject,
  onOpenHub,
  onUpdateProjectTitle,
  onCreateNewProject,
  onCreateFolder,
  onCreateDocument,
  onDeleteItem,
  onRestoreItem,
  onPermanentDeleteItem,
  onEmptyTrash,
  onMoveItem,
  onRenameItem,
  onReorderItem,
}) => {
  // Sidebar Resizing State (Notion-feel)
  const [sidebarWidth, setSidebarWidth] = useState<number>(240);
  const [isResizing, setIsResizing] = useState<boolean>(false);

  // Trash collapse state
  const [isTrashOpen, setIsTrashOpen] = useState<boolean>(false);

  // Drag & Drop state
  const [draggedItemId, setDraggedItemId] = useState<string | null>(null);
  const [dragOverFolderId, setDragOverFolderId] = useState<string | null>(null);

  // Folder Collapsed State
  const [collapsedFolders, setCollapsedFolders] = useState<Record<string, boolean>>({});

  // Menu / Quick Create States
  const [activeMenuFolderId, setActiveMenuFolderId] = useState<string | null>(null);
  const [showBottomAddMenu, setShowBottomAddMenu] = useState<boolean>(false);

  // Trash confirmation states (non-blocking for iFrame compatibility)
  const [confirmingPermanentDeleteId, setConfirmingPermanentDeleteId] = useState<string | null>(null);
  const [isConfirmingEmptyTrash, setIsConfirmingEmptyTrash] = useState<boolean>(false);

  // Rename state
  const [editingItemId, setEditingItemId] = useState<string | null>(null);
  const [editingTitle, setEditingTitle] = useState('');

  // Inline Project Title Edit state
  const [isEditingProjectTitle, setIsEditingProjectTitle] = useState(false);
  const [editingProjectTitle, setEditingProjectTitle] = useState('');

  // New Project Modal state
  const [isNewProjectModalOpen, setIsNewProjectModalOpen] = useState(false);
  const [newProjectTitleInput, setNewProjectTitleInput] = useState('');

  // Project Switcher state
  const [isProjectSwitcherOpen, setIsProjectSwitcherOpen] = useState(false);
  const projectSwitcherRef = useRef<HTMLDivElement>(null);

  // Resizable sidebar mouse event handlers
  const startResizing = useCallback((e: React.MouseEvent) => {
    e.preventDefault();
    e.stopPropagation();
    setIsResizing(true);
  }, []);

  useEffect(() => {
    if (!isResizing) return;

    const handleMouseMove = (e: MouseEvent) => {
      const newWidth = Math.min(Math.max(180, e.clientX), 480);
      setSidebarWidth(newWidth);
    };

    const handleMouseUp = () => {
      setIsResizing(false);
    };

    window.addEventListener('mousemove', handleMouseMove);
    window.addEventListener('mouseup', handleMouseUp);
    return () => {
      window.removeEventListener('mousemove', handleMouseMove);
      window.removeEventListener('mouseup', handleMouseUp);
    };
  }, [isResizing]);

  useEffect(() => {
    const handleClickOutside = (e: MouseEvent) => {
      if (projectSwitcherRef.current && !projectSwitcherRef.current.contains(e.target as Node)) {
        setIsProjectSwitcherOpen(false);
      }
    };
    if (isProjectSwitcherOpen) {
      window.addEventListener('mousedown', handleClickOutside);
    }
    return () => {
      window.removeEventListener('mousedown', handleClickOutside);
    };
  }, [isProjectSwitcherOpen]);

  const toggleFolder = (folderId: string) => {
    setCollapsedFolders((prev) => ({ ...prev, [folderId]: !prev[folderId] }));
  };

  // Unified Outline Icon Renderer
  const renderItemIcon = (itemType: 'folder' | 'document', docType?: DocumentType, isOpen: boolean = false) => {
    if (itemType === 'folder') {
      return isOpen ? (
        <FolderOpen className="w-4 h-4 text-graphite shrink-0" strokeWidth={1.5} />
      ) : (
        <Folder className="w-4 h-4 text-graphite shrink-0" strokeWidth={1.5} />
      );
    }

    switch (docType) {
      case 'screenplay':
        return <Clapperboard className="w-4 h-4 text-ink shrink-0" strokeWidth={1.5} />;
      case 'prose':
        return <BookOpen className="w-4 h-4 text-ink shrink-0" strokeWidth={1.5} />;
      default:
        return <FileText className="w-4 h-4 text-ink shrink-0" strokeWidth={1.5} />;
    }
  };

  const getChildren = (parentId: string | null) => {
    return project.binder
      .filter((item) => item.parentId === parentId && !item.trashed)
      .sort((a, b) => a.sortOrder - b.sortOrder);
  };

  const getTrashedItems = () => {
    return project.binder.filter((item) => item.trashed);
  };

  // Drag and drop tree reordering
  const handleDragStart = (e: React.DragEvent, id: string) => {
    e.stopPropagation();
    setDraggedItemId(id);
    e.dataTransfer.setData('text/plain', id);
    e.dataTransfer.effectAllowed = 'move';
  };

  const handleDragOver = (e: React.DragEvent, targetFolderId: string | null) => {
    e.preventDefault();
    e.stopPropagation();
    e.dataTransfer.dropEffect = 'move';
    if (dragOverFolderId !== targetFolderId) {
      setDragOverFolderId(targetFolderId);
    }
  };

  const handleDrop = (e: React.DragEvent, targetFolderId: string | null) => {
    e.preventDefault();
    e.stopPropagation();
    const draggedId = e.dataTransfer.getData('text/plain') || draggedItemId;
    setDraggedItemId(null);
    setDragOverFolderId(null);

    if (draggedId && draggedId !== targetFolderId && onMoveItem) {
      onMoveItem(draggedId, targetFolderId);
    }
  };

  const handleStartRename = (id: string, currentTitle: string, e: React.MouseEvent) => {
    e.stopPropagation();
    setEditingItemId(id);
    setEditingTitle(currentTitle);
  };

  const handleCommitRename = (id: string) => {
    if (editingTitle.trim()) {
      onRenameItem(id, editingTitle.trim());
    }
    setEditingItemId(null);
    setEditingTitle('');
  };

  // Project Title Inline Editing
  const handleStartEditingProjectTitle = () => {
    setIsEditingProjectTitle(true);
    setEditingProjectTitle(project.metadata.title);
  };

  const handleCommitProjectTitle = () => {
    if (editingProjectTitle.trim() && onUpdateProjectTitle) {
      onUpdateProjectTitle(editingProjectTitle.trim());
    }
    setIsEditingProjectTitle(false);
  };

  // New Project Workflow
  const handleOpenNewProjectModal = () => {
    setNewProjectTitleInput('Untitled Project');
    setIsNewProjectModalOpen(true);
  };

  const handleCreateNewProjectSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (onCreateNewProject) {
      onCreateNewProject(newProjectTitleInput.trim() || 'Untitled Project');
    }
    setIsNewProjectModalOpen(false);
  };

  // Immediate Document Creation without clunky input boxes
  const handleQuickAddDocument = (parentId: string | null, docType: DocumentType) => {
    const defaultTitle = docType === 'screenplay' ? 'Untitled Script' : 'Untitled Document';
    onCreateDocument(parentId, defaultTitle, docType);
    setActiveMenuFolderId(null);
    setShowBottomAddMenu(false);
  };

  const handleQuickAddFolder = (parentId: string | null) => {
    const defaultTitle = 'New Folder';
    onCreateFolder(parentId, defaultTitle);
    setActiveMenuFolderId(null);
    setShowBottomAddMenu(false);
  };

  const renderTree = (parentId: string | null, depth: number = 0) => {
    const items = getChildren(parentId);

    return (
      <div className="space-y-0.5">
        {items.map((item, idx) => {
          const isFirst = idx === 0;
          const isLast = idx === items.length - 1;

          if (item.itemType === 'folder') {
            const isCollapsed = !!collapsedFolders[item.id];
            const isEditing = editingItemId === item.id;
            const isMenuOpen = activeMenuFolderId === item.id;
            const isDragOver = dragOverFolderId === item.id;

            return (
              <div
                key={item.id}
                className="relative group/folder"
                draggable={true}
                onDragStart={(e) => handleDragStart(e, item.id)}
                onDragOver={(e) => handleDragOver(e, item.id)}
                onDrop={(e) => handleDrop(e, item.id)}
              >
                <div
                  className={`group flex items-center justify-between px-2 py-1 rounded-[var(--radius-ui)] cursor-pointer text-[13px] font-medium text-graphite transition-colors ${
                    isDragOver ? 'bg-neutral-100 ring-1 ring-rule' : 'hover:bg-neutral-200/30'
                  }`}
                  style={{ paddingLeft: `${Math.max(8, depth * 14 + 8)}px` }}
                  onClick={() => toggleFolder(item.id)}
                  title={item.title}
                >
                  <div className="flex items-center gap-1.5 min-w-0 flex-1 mr-1">
                    <button
                      className="text-graphite/60 hover:text-ink p-0.5 rounded cursor-pointer shrink-0"
                      onClick={(e) => {
                        e.stopPropagation();
                        toggleFolder(item.id);
                      }}
                    >
                      {isCollapsed ? (
                        <ChevronRight className="w-3.5 h-3.5" strokeWidth={1.5} />
                      ) : (
                        <ChevronDown className="w-3.5 h-3.5" strokeWidth={1.5} />
                      )}
                    </button>
                    {renderItemIcon('folder', undefined, !isCollapsed)}

                    {isEditing ? (
                      <div
                        className="flex items-center gap-1 flex-1"
                        onClick={(e) => e.stopPropagation()}
                      >
                        <input
                          type="text"
                          autoFocus
                          value={editingTitle}
                          onChange={(e) => setEditingTitle(e.target.value)}
                          onKeyDown={(e) => {
                            if (e.key === 'Enter') handleCommitRename(item.id);
                            if (e.key === 'Escape') setEditingItemId(null);
                          }}
                          className="w-full text-[13px] bg-paper border border-rule rounded px-1.5 py-0.5 outline-none focus:border-ink"
                        />
                        <button
                          onClick={() => handleCommitRename(item.id)}
                          className="p-1 text-ink hover:bg-neutral-200 rounded"
                        >
                          <Check className="w-3.5 h-3.5" strokeWidth={1.5} />
                        </button>
                      </div>
                    ) : (
                      <span className="truncate text-ink font-medium select-none">
                        {item.title}
                      </span>
                    )}
                  </div>

                  {!isEditing && (
                    <div className="opacity-0 group-hover:opacity-100 flex items-center gap-0.5 shrink-0 transition-opacity">
                      {/* Notion-style Quick Add "+" Button */}
                      <button
                        title="Add inside..."
                        className="p-1 hover:bg-neutral-200/50 rounded text-graphite hover:text-ink cursor-pointer"
                        onClick={(e) => {
                          e.stopPropagation();
                          setActiveMenuFolderId(isMenuOpen ? null : item.id);
                        }}
                      >
                        <Plus className="w-3.5 h-3.5" strokeWidth={1.5} />
                      </button>

                      {/* Rename */}
                      <button
                        title="Rename"
                        className="p-1 hover:bg-neutral-200/50 rounded text-graphite hover:text-ink cursor-pointer"
                        onClick={(e) => handleStartRename(item.id, item.title, e)}
                      >
                        <Pencil className="w-3 h-3" strokeWidth={1.5} />
                      </button>

                      {/* Delete (Soft delete to Trash) */}
                      <button
                        title="Move folder to Trash"
                        className="p-1 hover:text-editor-red rounded text-graphite/40 cursor-pointer"
                        onClick={(e) => {
                          e.stopPropagation();
                          onDeleteItem(item.id);
                        }}
                      >
                        <Trash2 className="w-3 h-3" strokeWidth={1.5} />
                      </button>
                    </div>
                  )}
                </div>

                {/* Inline Quick Add Dropdown Menu */}
                {isMenuOpen && (
                  <div
                    className="absolute left-6 top-full mt-0.5 w-48 bg-white rounded-lg shadow-lg border border-neutral-200 py-1 z-30 animate-in fade-in duration-100"
                    onClick={(e) => e.stopPropagation()}
                  >
                    <div className="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-neutral-400">
                      Create in "{item.title}"
                    </div>
                    <button
                      className="w-full text-left px-3 py-1.5 text-xs hover:bg-neutral-50 flex items-center gap-2 text-neutral-700 cursor-pointer"
                      onClick={() => handleQuickAddDocument(item.id, 'screenplay')}
                    >
                      <Clapperboard className="w-3.5 h-3.5 text-neutral-600" strokeWidth={1.5} />
                      <span>Screenplay</span>
                    </button>
                    <button
                      className="w-full text-left px-3 py-1.5 text-xs hover:bg-neutral-50 flex items-center gap-2 text-neutral-700 cursor-pointer"
                      onClick={() => handleQuickAddDocument(item.id, 'prose')}
                    >
                      <BookOpen className="w-3.5 h-3.5 text-neutral-600" strokeWidth={1.5} />
                      <span>Prose / Document</span>
                    </button>
                    <div className="h-px bg-neutral-200 my-1" />
                    <button
                      className="w-full text-left px-3 py-1.5 text-xs hover:bg-neutral-50 flex items-center gap-2 text-neutral-700 cursor-pointer"
                      onClick={() => handleQuickAddFolder(item.id)}
                    >
                      <Folder className="w-3.5 h-3.5 text-neutral-500" strokeWidth={1.5} />
                      <span>Subfolder</span>
                    </button>
                  </div>
                )}

                {!isCollapsed && renderTree(item.id, depth + 1)}
              </div>
            );
          }

          // Document Item
          const isActive = activeDocId === item.id;
          const isEditing = editingItemId === item.id;

          return (
            <div
              key={item.id}
              draggable={true}
              onDragStart={(e) => handleDragStart(e, item.id)}
              className={`group flex items-center justify-between px-2 py-1.5 rounded-[var(--radius-ui)] cursor-pointer text-[13px] transition-colors ${
                isActive
                  ? 'bg-neutral-200/40 text-ink font-medium'
                  : 'hover:bg-neutral-200/20 text-graphite hover:text-ink'
              }`}
              style={{ paddingLeft: `${Math.max(8, depth * 14 + 20)}px` }}
              onClick={() => onSelectDoc(item.id)}
              title={item.title}
            >
              <div className="flex items-center gap-2 min-w-0 flex-1 mr-1">
                {renderItemIcon('document', item.documentType)}
                {isEditing ? (
                  <div
                    className="flex items-center gap-1 flex-1"
                    onClick={(e) => e.stopPropagation()}
                  >
                    <input
                      type="text"
                      autoFocus
                      value={editingTitle}
                      onChange={(e) => setEditingTitle(e.target.value)}
                      onKeyDown={(e) => {
                        if (e.key === 'Enter') handleCommitRename(item.id);
                        if (e.key === 'Escape') setEditingItemId(null);
                      }}
                      className="w-full text-[13px] bg-paper text-ink border border-rule rounded px-1.5 py-0.5 outline-none focus:border-ink"
                    />
                    <button
                      onClick={() => handleCommitRename(item.id)}
                      className="p-1 text-ink hover:bg-neutral-200 rounded cursor-pointer"
                    >
                      <Check className="w-3.5 h-3.5" strokeWidth={1.5} />
                    </button>
                  </div>
                ) : (
                  <span className="truncate text-ink font-normal group-hover:text-ink select-none">
                    {item.title}
                  </span>
                )}
              </div>

              {!isEditing && (
                <div className="opacity-0 group-hover:opacity-100 flex items-center gap-0.5 shrink-0 transition-opacity">
                  {/* Rename */}
                  <button
                    title="Rename"
                    className="p-1 rounded hover:bg-neutral-200/50 text-graphite hover:text-ink cursor-pointer"
                    onClick={(e) => handleStartRename(item.id, item.title, e)}
                  >
                    <Pencil className="w-3 h-3" strokeWidth={1.5} />
                  </button>

                  {/* Delete (Soft delete to Trash) */}
                  <button
                    title="Move document to Trash"
                    className="p-1 rounded hover:text-editor-red text-graphite/40 cursor-pointer"
                    onClick={(e) => {
                      e.stopPropagation();
                      onDeleteItem(item.id);
                    }}
                  >
                    <Trash2 className="w-3 h-3" strokeWidth={1.5} />
                  </button>
                </div>
              )}
            </div>
          );
        })}
      </div>
    );
  };

  return (
    <aside
      style={{ width: `${sidebarWidth}px` }}
      className="relative border-r border-rule bg-panel flex flex-col h-full select-none shrink-0 group/sidebar transition-all duration-75 text-ink"
    >
      {/* Resizable Border Drag Handle */}
      <div
        onMouseDown={startResizing}
        title="Drag to resize sidebar"
        className={`absolute top-0 right-0 w-px h-full cursor-col-resize hover:bg-editor-red transition-colors z-20 ${
          isResizing ? 'bg-editor-red w-0.5' : ''
        }`}
      />

      {/* Notion-style Project Header */}
      <div className="px-3.5 py-3 border-b border-rule bg-panel flex items-center justify-between">
        <div className="min-w-0 flex-1 mr-2">
          <h2 className="text-[10px] font-bold text-graphite opacity-50 tracking-widest">
            PROJECT BINDER
          </h2>
          {isEditingProjectTitle ? (
            <div className="flex items-center gap-1 mt-0.5">
              <input
                type="text"
                autoFocus
                value={editingProjectTitle}
                onChange={(e) => setEditingProjectTitle(e.target.value)}
                onKeyDown={(e) => {
                  if (e.key === 'Enter') handleCommitProjectTitle();
                  if (e.key === 'Escape') setIsEditingProjectTitle(false);
                }}
                onBlur={handleCommitProjectTitle}
                className="w-full text-[13px] font-semibold bg-paper text-ink border border-rule rounded px-1.5 py-0.5 outline-none focus:border-ink"
              />
            </div>
          ) : (
            <div className="relative" ref={projectSwitcherRef}>
              <div
                className={`group/title flex items-center gap-1.5 text-[14px] font-semibold text-ink hover:text-editor-red cursor-pointer truncate mt-0.5 transition-colors ${isProjectSwitcherOpen ? 'text-editor-red' : ''}`}
                onClick={() => setIsProjectSwitcherOpen(!isProjectSwitcherOpen)}
                title="Click to switch project"
              >
                <span className="truncate">{project.metadata.title}</span>
                <ChevronDown className={`w-3.5 h-3.5 text-graphite/40 transition-transform duration-200 ${isProjectSwitcherOpen ? 'rotate-180' : ''}`} />
              </div>

              {isProjectSwitcherOpen && (
                <div className="absolute left-0 top-full mt-1.5 w-64 bg-paper rounded-[var(--radius-modal)] shadow-2xl border border-rule py-1.5 z-50 animate-in fade-in slide-in-from-top-1 duration-100">
                  <div className="px-3 py-1 text-[10px] font-bold text-graphite opacity-50 flex items-center justify-between">
                    <span>Recent Projects</span>
                  </div>
                  
                  <div className="max-h-60 overflow-y-auto mt-1">
                    {allProjects?.map(p => (
                      <button
                        key={p.metadata.id}
                        onClick={() => {
                          onSelectProject?.(p.metadata.id);
                          setIsProjectSwitcherOpen(false);
                        }}
                        className={`w-full text-left px-3 py-1.5 text-[13px] hover:bg-neutral-100/50 flex items-center justify-between group cursor-pointer transition-colors ${p.metadata.id === project.metadata.id ? 'text-editor-red font-medium' : 'text-ink'}`}
                      >
                        <span className="truncate flex-1 font-medium">{p.metadata.title}</span>
                        {p.metadata.id === project.metadata.id && <Check className="w-3 h-3 shrink-0 text-editor-red" />}
                      </button>
                    ))}
                  </div>

                  <div className="h-px bg-rule my-1.5 mx-2" />
                  
                  <button
                    onClick={() => {
                      handleOpenNewProjectModal();
                      setIsProjectSwitcherOpen(false);
                    }}
                    className="w-full text-left px-3 py-2 text-[13px] hover:bg-neutral-100/50 text-editor-red font-semibold flex items-center gap-2 cursor-pointer transition-colors"
                  >
                    <Plus className="w-3.5 h-3.5" />
                    <span>Create New Project</span>
                  </button>

                  <button
                    onClick={() => {
                      onOpenHub?.();
                      setIsProjectSwitcherOpen(false);
                    }}
                    className="w-full text-left px-3 py-2 text-[13px] hover:bg-neutral-100/50 text-graphite flex items-center gap-2 cursor-pointer transition-colors"
                  >
                    <Sparkles className="w-3.5 h-3.5" />
                    <span>Open Project Hub</span>
                  </button>
                </div>
              )}
            </div>
          )}
        </div>

        <div className="flex items-center gap-0.5">
          {/* New Project / Studio Hub Button */}
          <button
            onClick={() => {
              if (onOpenHub) {
                onOpenHub();
              } else {
                handleOpenNewProjectModal();
              }
            }}
            className="p-1 text-graphite/60 hover:text-ink hover:bg-neutral-200/40 rounded cursor-pointer transition-colors"
            title="Open Studio Project Hub / New Project"
          >
            <FolderPlus className="w-4 h-4" strokeWidth={1.5} />
          </button>

          {/* Quick Add at Root */}
          <button
            onClick={() => setShowBottomAddMenu(!showBottomAddMenu)}
            className="p-1 text-graphite/60 hover:text-ink hover:bg-neutral-200/40 rounded cursor-pointer transition-colors"
            title="Add item to root"
          >
            <Plus className="w-4 h-4" strokeWidth={1.5} />
          </button>
        </div>
      </div>

      {/* Root Add Menu Dropdown */}
      {showBottomAddMenu && (
        <div className="mx-3 my-2 bg-paper rounded-[var(--radius-modal)] shadow-xl border border-rule py-1 z-30 animate-in fade-in duration-150">
          <div className="px-3 py-1 text-[10px] font-bold text-graphite opacity-60">
            CREATE NEW ITEM
          </div>
          <button
            className="w-full text-left px-3 py-1.5 text-[13px] hover:bg-rule/40 flex items-center gap-2.5 text-ink cursor-pointer"
            onClick={() => handleQuickAddDocument(null, 'screenplay')}
          >
            <Clapperboard className="w-3.5 h-3.5 text-graphite" strokeWidth={1.5} />
            <span>Screenplay</span>
          </button>
          <button
            className="w-full text-left px-3 py-1.5 text-[13px] hover:bg-rule/40 flex items-center gap-2.5 text-ink cursor-pointer"
            onClick={() => handleQuickAddDocument(null, 'prose')}
          >
            <BookOpen className="w-3.5 h-3.5 text-graphite" strokeWidth={1.5} />
            <span>Prose / Document</span>
          </button>
          <div className="h-px bg-rule my-1 mx-2" />
          <button
            className="w-full text-left px-3 py-1.5 text-[13px] hover:bg-rule/40 flex items-center gap-2.5 text-ink cursor-pointer"
            onClick={() => handleQuickAddFolder(null)}
          >
            <Folder className="w-3.5 h-3.5 text-graphite" strokeWidth={1.5} />
            <span>Folder</span>
          </button>
        </div>
      )}

      {/* Binder Tree Items Container */}
      <div
        className="flex-1 overflow-y-auto p-2 space-y-0.5 bg-panel"
        onDragOver={(e) => handleDragOver(e, null)}
        onDrop={(e) => handleDrop(e, null)}
      >
        {renderTree(null, 0)}
      </div>

      {/* Trash Bin Section */}
      <div
        className="border-t border-rule p-2 bg-panel hover:bg-paper/80 transition-colors"
        onDragOver={(e) => {
          e.preventDefault();
          e.dataTransfer.dropEffect = 'move';
        }}
        onDrop={(e) => {
          e.preventDefault();
          const draggedId = e.dataTransfer.getData('text/plain');
          if (draggedId) {
            onDeleteItem(draggedId);
          }
        }}
      >
        <div className="flex items-center justify-between px-2 py-1 text-xs text-neutral-500 font-medium">
          <button
            onClick={() => setIsTrashOpen(!isTrashOpen)}
            className="flex items-center gap-1.5 hover:text-neutral-800 cursor-pointer"
          >
            <Trash2 className="w-3.5 h-3.5 text-neutral-400" />
            <span>Trash ({getTrashedItems().length})</span>
            <ChevronDown
              className={`w-3 h-3 transition-transform duration-150 ${
                isTrashOpen ? 'rotate-180' : ''
              }`}
            />
          </button>

          {getTrashedItems().length > 0 && onEmptyTrash && (
            isConfirmingEmptyTrash ? (
              <div className="flex items-center gap-1">
                <span className="text-[10px] text-neutral-500 font-medium">Empty All?</span>
                <button
                  onClick={(e) => {
                    e.stopPropagation();
                    onEmptyTrash();
                    setIsConfirmingEmptyTrash(false);
                  }}
                  className="text-[10px] bg-editor-red hover:opacity-90 text-white font-bold px-1.5 py-0.5 rounded-[var(--radius-ui)] cursor-pointer transition-colors"
                >
                  Yes
                </button>
                <button
                  onClick={(e) => {
                    e.stopPropagation();
                    setIsConfirmingEmptyTrash(false);
                  }}
                  className="text-[10px] text-graphite hover:bg-neutral-200 px-1 py-0.5 rounded-[var(--radius-ui)] cursor-pointer"
                >
                  Cancel
                </button>
              </div>
            ) : (
              <button
                onClick={(e) => {
                  e.stopPropagation();
                  setIsConfirmingEmptyTrash(true);
                }}
                className="text-[10px] text-editor-red hover:opacity-80 hover:underline cursor-pointer font-semibold px-1 py-0.5 rounded hover:bg-neutral-200/40 transition-colors"
                title="Empty all trashed items permanently"
              >
                Empty Trash
              </button>
            )
          )}
        </div>

        {isTrashOpen && (
          <div className="mt-1 space-y-1 pl-1 max-h-40 overflow-y-auto">
            {getTrashedItems().length === 0 ? (
              <div className="text-[11px] text-graphite/40 italic px-2 py-1">Trash is empty</div>
            ) : (
              getTrashedItems().map((tItem) => (
                <div
                  key={tItem.id}
                  className="flex items-center justify-between px-2 py-1 rounded-[var(--radius-ui)] bg-paper border border-rule text-xs text-graphite hover:border-graphite/30 transition-all"
                >
                  <div className="flex items-center gap-1.5 min-w-0 flex-1 mr-2">
                    {renderItemIcon(tItem.itemType, tItem.documentType)}
                    <span className="truncate text-[11px] font-medium text-ink">
                      {tItem.title}
                    </span>
                  </div>
                  <div className="flex items-center gap-1 shrink-0">
                    {confirmingPermanentDeleteId === tItem.id ? (
                      <div className="flex items-center gap-1">
                        <span className="text-[10px] text-editor-red font-semibold">Delete?</span>
                        <button
                          onClick={() => {
                            if (onPermanentDeleteItem) onPermanentDeleteItem(tItem.id);
                            setConfirmingPermanentDeleteId(null);
                          }}
                          className="text-[10px] bg-editor-red text-white font-bold px-1.5 py-0.5 rounded-[var(--radius-ui)] cursor-pointer"
                          title="Confirm permanent deletion"
                        >
                          Yes
                        </button>
                        <button
                          onClick={() => setConfirmingPermanentDeleteId(null)}
                          className="text-[10px] text-graphite hover:bg-neutral-100 px-1 py-0.5 rounded-[var(--radius-ui)] cursor-pointer"
                        >
                          No
                        </button>
                      </div>
                    ) : (
                      <>
                        {onRestoreItem && (
                          <button
                            onClick={() => onRestoreItem(tItem.id)}
                            title="Restore item to active project"
                            className="p-1 hover:bg-neutral-200/50 rounded text-graphite hover:text-ink cursor-pointer transition-colors"
                          >
                            <RotateCcw className="w-3.5 h-3.5" />
                          </button>
                        )}
                        {onPermanentDeleteItem && (
                          <button
                            onClick={() => setConfirmingPermanentDeleteId(tItem.id)}
                            title="Delete permanently from database"
                            className="p-1 hover:text-editor-red rounded text-graphite/40 cursor-pointer transition-colors"
                          >
                            <X className="w-3.5 h-3.5" />
                          </button>
                        )}
                      </>
                    )}
                  </div>
                </div>
              ))
            )}
          </div>
        )}
      </div>

      {/* Clean Notion-style Bottom Action */}
      <div className="p-2 border-t border-rule flex items-center justify-between text-[13px]">
        <button
          onClick={() => handleQuickAddDocument(null, 'screenplay')}
          className="flex items-center gap-1.5 px-2 py-1.5 rounded-[var(--radius-ui)] hover:bg-neutral-200/40 text-graphite hover:text-ink font-medium cursor-pointer transition-colors w-full"
        >
          <Plus className="w-4 h-4 text-graphite/60" strokeWidth={1.5} />
          <span>New Document</span>
        </button>
      </div>

      {/* New Project Modal */}
      {isNewProjectModalOpen && (
        <div className="fixed inset-0 bg-ink/40 backdrop-blur-[2px] flex items-center justify-center z-50 p-4">
          <div className="bg-paper rounded-[var(--radius-modal)] shadow-2xl border border-rule max-w-sm w-full p-6 space-y-5 animate-in fade-in zoom-in-95 duration-200">
            <div className="flex items-center justify-between border-b border-rule pb-3">
              <h3 className="text-[14px] font-semibold text-ink">Create New Project</h3>
              <button
                onClick={() => setIsNewProjectModalOpen(false)}
                className="text-graphite/60 hover:text-ink p-1 rounded hover:bg-neutral-100 cursor-pointer transition-colors"
              >
                <X className="w-4.5 h-4.5" />
              </button>
            </div>
            <form onSubmit={handleCreateNewProjectSubmit} className="space-y-4">
              <div>
                <label className="block text-[11px] font-bold text-graphite uppercase tracking-widest mb-1.5">
                  Project Title
                </label>
                <input
                  type="text"
                  autoFocus
                  value={newProjectTitleInput}
                  onChange={(e) => setNewProjectTitleInput(e.target.value)}
                  placeholder="e.g. My Next Feature Script"
                  className="w-full text-[13px] bg-paper border border-rule rounded-[var(--radius-ui)] px-3 py-2 text-ink outline-none focus:border-ink transition-all"
                />
              </div>
              <div className="flex justify-end gap-2 pt-1">
                <button
                  type="button"
                  onClick={() => setIsNewProjectModalOpen(false)}
                  className="px-4 py-2 text-[13px] font-medium text-graphite hover:bg-neutral-100 rounded-[var(--radius-ui)] cursor-pointer transition-colors"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="px-4 py-2 text-[13px] font-semibold text-white bg-editor-red hover:opacity-90 rounded-[var(--radius-ui)] cursor-pointer transition-colors"
                >
                  Create Project
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </aside>
  );
};
